# ============================================================
# InsForge (frontend — Vite, prefijo VITE_ obligatorio)
# ============================================================
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# Clave pública VAPID para notificaciones push (ver sección VAPID más abajo).
# Es seguro exponerla en el frontend: es la mitad pública del par de claves.
VITE_VAPID_PUBLIC_KEY=
# URL pública del compute service (Railway), sin barra final. La usa la
# página pública de reservas (/r/:slug); en Railway, APP_URL debe ser la URL
# del frontend para que CORS la permita.
VITE_API_URL=

# ============================================================
# InsForge (compute service — server/, y Edge Functions vía `secrets add`)
# INSFORGE_API_KEY es una clave admin de proyecto completo (equivalente a
# la service role key de otras plataformas): NUNCA exponerla al frontend.
# ============================================================
INSFORGE_URL=
INSFORGE_API_KEY=

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Opcional: endpoint compatible con la API de OpenAI (ej. OpenRouter) para
# desarrollo local sin una key propia de OpenAI. Dejar vacío en producción.
OPENAI_BASE_URL=

# ============================================================
# Telegram — CANAL RECOMENDADO PARA ARRANCAR SIN COSTO. No requiere ninguna
# variable de entorno acá: cada organización conecta su propio bot token
# (creado gratis con @BotFather) desde el dashboard, vía la Edge Function
# telegram-connect, y el compute service lo atiende automáticamente con
# long-polling (sin necesitar URL pública ni webhook).
# ============================================================

# ============================================================
# WhatsApp Business (YCloud) — opcional, tiene costo (YCloud + WhatsApp
# Business Platform de Meta cobran por conversación/plantilla). Igual que
# Telegram, no requiere ninguna variable de entorno acá: cada organización
# conecta su propia API key de YCloud desde el dashboard, vía la Edge
# Function ycloud-connect.
# ============================================================

# ============================================================
# Google OAuth / Calendar
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3011/api/integrations/google/callback

# ============================================================
# Notificaciones push (Web Push + VAPID) — opcional: si se deja vacío, la
# app funciona igual pero sin poder mandar notificaciones. Generar el par
# de claves una sola vez con:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY debe ser IDÉNTICA a VITE_VAPID_PUBLIC_KEY de arriba (son
# las dos mitades del mismo par: la pública va también al frontend, la
# privada NUNCA).
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com

# ============================================================
# Aplicación
# ============================================================
APP_URL=http://localhost:5173
API_URL=http://localhost:3011
PORT=3011

# Timezone por defecto para nuevas organizaciones
DEFAULT_TIMEZONE=America/Bogota

# Entorno
NODE_ENV=development

# Secreto usado para firmar/verificar el `state` del flujo OAuth de Google
# (CSRF). Debe configurarse IDÉNTICO como secreto de InsForge
# (OAUTH_STATE_SECRET) para que la Edge Function google-oauth-start y el
# compute service (que verifica el callback) firmen/validen con la misma clave.
OAUTH_STATE_SECRET=change-me-in-production

# Cifra integrations.credentials (tokens de Google, API keys de YCloud, bot
# tokens de Telegram) antes de guardarlo en la base. Debe configurarse
# IDÉNTICO como secreto de InsForge (INTEGRATIONS_ENCRYPTION_KEY): las Edge
# Functions que conectan/desconectan cada canal también leen y escriben esa
# columna, y necesitan la misma clave para cifrar/descifrar lo que escribe o
# lee el compute service.
INTEGRATIONS_ENCRYPTION_KEY=change-me-in-production-integrations-key

# Correo (o varios separados por coma) que recibe una alerta cuando algo falla
# seguido: 5 veces el mismo tipo de falla en 10 minutos, como mucho una por
# hora (ver server/src/lib/alerts.ts). Vacío = la alerta solo queda en el log.
ALERT_EMAIL=

# ============================================================
# IMPORTANTE para desarrollo local: poné "true" en tu .env local.
# Con las credenciales de producción, un server local lee los MISMOS bots de
# Telegram que Railway: Telegram entrega cada mensaje a ambos procesos y el
# cliente recibe respuestas dobles (incidentes del 25 y 26 de septiembre).
# En producción (Railway) dejalo sin definir o en "false".
# ============================================================
DISABLE_BACKGROUND_WORKERS=false

# ============================================================
# Telegram: "polling" (por defecto; una sola instancia del server) o
# "webhook" (para escalar a varias instancias). En webhook hacen falta la
# URL pública HTTPS del server y un secreto propio de 16+ caracteres
# (ej. `openssl rand -hex 32`). Sin ellos, el server sigue en polling.
# ============================================================
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
